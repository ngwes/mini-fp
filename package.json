{
  "name": "@ngwes/mini-fp",
  "version": "2.0.0",
  "description": "A minimal TypeScript functional programming library: Option, Either, Try, Validate and their async variants, with zero dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngwes/mini-fp.git"
  },
  "homepage": "https://ngwes.github.io/mini-fp/",
  "bugs": {
    "url": "https://github.com/ngwes/mini-fp/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest run --inspect --no-file-parallelism",
    "test:debug:filter": "vitest run --inspect-brk --no-file-parallelism -t",
    "prepare": "husky"
  },
  "keywords": [
    "functional-programming",
    "typescript",
    "option",
    "either",
    "try",
    "validate",
    "monad",
    "error-handling"
  ],
  "author": "ngwes",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
